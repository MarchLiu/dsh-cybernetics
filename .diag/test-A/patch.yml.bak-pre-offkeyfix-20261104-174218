- id: hypatia-auto-memory
  name: dsh-hypatia-auto-memory
  config:
    consolidation:
      enabled: true
      models:
        - provider: zai-coding-cn
          model: glm-5.3-flash
        - provider: kimi
          model: k3
        - provider: deepseek-official
          model: deepseek-flash
        - provider: ollama
          model: qwen3.8:latest
      maxInputTokens: 16000
      maxOutputTokens: 2000
      timeoutMs: 120000
      checkEveryTurns: 5
      minNewTokens: 3000
      maxWorkUnitsPerRun: 3
      adjudicate: true
      dedupMaxDistance: 0.45
      dedupCandidates: 5
      cascade:
        enabled: true
        batchSize: 16

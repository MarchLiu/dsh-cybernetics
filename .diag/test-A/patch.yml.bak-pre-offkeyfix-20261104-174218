- id: llm-pi-ai
  name: '@deepseek-ai/dsh-llm-pi-ai'
  config:
    providers:
      zai-coding-cn:
        apiKeyEnv: ZHIPU_API_KEY
        displayName: GLM (智谱)
        models:
          - id: glm-4.5-air
          - id: glm-4.7
          - id: glm-5-turbo
          - id: glm-5.1
          - id: glm-5.2
          - id: glm-5v-turbo
          - id: glm-5.3
            name: GLM-5.3
            contextWindow: 1000000
            maxTokens: 131072
            reasoningEfforts:
              false: null
              minimal: high
              low: high
              medium: high
              high: high
              max: max
            compat:
              supportsReasoningEffort: true
          - id: glm-5.3-flash
            name: GLM-5.3 Flash
            contextWindow: 1000000
            maxTokens: 131072
            input:
              - text
              - image
            reasoningEfforts:
              false: null
              minimal: high
              low: high
              medium: high
              high: high
              max: max
            compat:
              supportsReasoningEffort: true
      kimi:
        apiKeyEnv: KIMI_API_KEY
        displayName: Kimi Code
        api: openai-completions
        baseURL: https://api.kimi.com/coding/v1
        models:
          - id: k3
            name: Kimi K3
            contextWindow: 1048576
            input:
              - text
              - image
          - id: k3-256k
            name: Kimi K3 (256k)
            contextWindow: 262144
            input:
              - text
              - image
          - id: kimi-for-coding
            name: Kimi K2.7 Code
            contextWindow: 262144
            input:
              - text
              - image
          - id: kimi-for-coding-highspeed
            name: Kimi K2.7 Code HighSpeed
            contextWindow: 262144
            input:
              - text
              - image
      ollama:
        displayName: Ollama (本地)
        apiKeyEnv: OLLAMA_API_KEY
        api: openai-completions
        baseURL: http://localhost:11434/v1
        models:
          - id: qwen3.8:latest
            name: Qwen3.8 27B (Ollama)
            contextWindow: 262144
            maxTokens: 16384
            input:
              - text
              - image
          - id: qwen3-vl:latest
            name: Qwen3-VL 8B (Ollama)
            contextWindow: 262144
            maxTokens: 16384
            input:
              - text
              - image

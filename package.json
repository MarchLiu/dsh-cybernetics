{
  "name": "@mars.liu/dsh-cybernetics",
  "version": "0.25.2",
  "license": "MIT",
  "private": false,
  "files": [
    "src",
    "lib",
    "workflows",
    "docs",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "description": "Cybernetic work protocol for DSH: the session goal (dsh-goal) driven loop of task -> verify -> triage agents, implicitly advanced via one workflow run per round. Server plugin + client goal tab.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-commands"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "*"
  }
}
